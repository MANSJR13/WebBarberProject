@model ClientesModel
@{
    ViewData["Title"] = "Editar Cliente";
}


<div class="text-center">
    <h1 class="display-5">Editar cliente</h1>
</div>

<br />

<form asp-controller="Clientes" asp-action="Alterar" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label for="Nome" class="form-label">Nome do cliente</label>
        <input type="text" asp-for="Nome" class="form-control" placeholder="Digite o Nome">
        @Html.ValidationMessageFor(x => x.Nome)
    </div>
    <div class="mb-3">
        <label for="Email" class="form-label">Email do cliente</label>
        <input type="text" asp-for="Email" class="form-control" placeholder="Digite o Email">
        @Html.ValidationMessageFor(x => x.Email)
    </div>
    <div class="mb-3">
        <label for="Celular" class="form-label">Celular do cliente</label>
        <input type="text" asp-for="Celular" class="form-control" placeholder="Digite o Celular">
        @Html.ValidationMessageFor(x => x.Celular)
    </div>

    <button type="submit" class="btn btn-primary">Alterar cliente</button>
    <a class="btn btn-secondary" asp-controller="Clientes" asp-action="Index" role="button">Voltar</a>
</form>

