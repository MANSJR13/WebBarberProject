@model List<ServicosModel>
@{
    ViewData["Title"] = "Lista de serviços";
}
<div class="d-grid gap-2 d-md-flex justify-content-md-start">
    <a class="btn btn-danger" role="button" asp-controller="Servicos" asp-action="Criar">Adicionar novo serviço</a>
</div>

<h2 class="display-5">Lista de serviços</h2>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nome</th>
            <th scope="col">Descrição</th>
            <th scope="col">Preço</th>
            <th scope="col">Duração</th>
            <th scope="col">Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null & Model.Any())
        {
            foreach (ServicosModel servicos in Model)
            {
                <tr>
                    <th scope="row">@servicos.Id</th>
                    <td>@servicos.Nome</td>
                    <td>@servicos.Descricao</td>
                    <td>@servicos.Preco</td>
                    <td>@servicos.Duracao</td>
                    <td>@servicos.Status</td>
                    <td>
                        <div class="btn-group" role="group">
                            <a role="button" class="btn btn-primary" asp-route-id="@servicos.Id" asp-controller="Servicos" asp-action="Editar">Editar</a>
                            <a role="button" class="btn btn-warning" asp-route-id="@servicos.Id" asp-controller="Servicos" asp-action="ApagarConfirmar">Apagar</a>
                        </div>
                    </td>
                </tr>
            }
        }
                
    </tbody>
</table>

