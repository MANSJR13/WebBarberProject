@{
    ViewData["Title"] = "Lista de serviços";
}
<div class="d-grid gap-2 d-md-flex justify-content-md-start">
    <a class="btn btn-danger" role="button" asp-controller="Servicos" asp-action="Criar">Adicionar novo serviço</a>
</div>

<h2 class="display-5">Lista de serviços</h2>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nome</th>
            <th scope="col">Descrição</th>
            <th scope="col">Preço</th>
            <th scope="col">Duração</th>
            <th scope="col">Status</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <th scope="row">1</th>
            <td>Corte Low Fade</td>
            <td>Cabelo</td>
            <td>R$ 50.00</td>
            <td>00:30</td>
            <td>Ativo</td>
        </tr>
        <tr>
            <th scope="row">1</th>
            <td>Luzes</td>
            <td>Cabelo</td>
            <td>R$ 150.00</td>
            <td>00:60</td>
            <td>Ativo</td>
        </tr>
        <tr>
            <th scope="row">1</th>
            <td>Barba e Sombrancelha</td>
            <td>Barba</td>
            <td>R$ 60.00</td>
            <td>00:25</td>
            <td>Inativo</td>
        </tr>
    </tbody>
</table>

