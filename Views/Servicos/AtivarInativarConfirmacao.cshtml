@model ServicosModel
@{
    ViewData["Title"] = "Confirmar o ativar/inativar do serviço";
}

<div class="text-center">
    <h1 class="display-5">@Model.Status serviço </h1>
</div>
<br />
<div>
    <h3>Tem certeza que deseja @Model.Status o serviço (@Model.Nome) ?</h3>
</div>
<br />
<a class="btn btn-primary" asp-controller="Servicos" asp-action="AlterarStatus" asp-route-id="@Model.Id" role="button">Confirmar</a>
<a class="btn btn-secondary" role="button" asp-controller="Servicos" asp-action="Index">Cancelar</a>