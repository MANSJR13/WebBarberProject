@model ServicosModel
@{
    ViewData["Title"] = "Criar Serviço";
}

<h1 class="display-5">Adicionar serviço</h1>

<form>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Nome</label>
        <input type="text" class="form-control" placeholder="Nome do serviço">
    </div>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Descrição</label>
        <input type="text" class="form-control" placeholder="Escolha uma descrição">
    </div>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Preço</label>
        <input type="text" class="form-control" placeholder="Digite o preço">
    </div>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Duração</label>
        <input type="text" class="form-control" placeholder="Informe a duração">
    </div>
    <div class="mb-3">
        <label for="exampleInputEmail1" class="form-label">Status do Serviço</label>
        <input type="text" class="form-control" placeholder="Ativo/Inativo">
    </div>
    <button type="submit" class="btn btn-primary">Adicionar</button>
</form>
